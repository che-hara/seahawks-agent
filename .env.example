# Anthropic API key — writes the post text
ANTHROPIC_API_KEY=sk-ant-...

# Model that writes the post text
ANTHROPIC_MODEL=claude-sonnet-5

# Bluesky credentials (use an app password, not your account password)
BLUESKY_USERNAME=likeablechelsey.com
BLUESKY_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Handle shown in the dashboard / post attribution
BLUESKY_HANDLE=likeablechelsey.com

# Password gate for the approval dashboard. REQUIRED — the agent refuses to
# start without it. Use a long random value, not a memorable word:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
DASHBOARD_PASSWORD=

# Port the dashboard listens on
PORT=3000
